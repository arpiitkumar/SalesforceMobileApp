<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- AABL launch / splash theme: dark brand ground instead of a white flash. -->
    <style name="AABLLaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/aabl_ink</item>
        <item name="android:statusBarColor">@color/aabl_ink</item>
        <item name="android:navigationBarColor">@color/aabl_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 12+ SplashScreen API -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/aabl_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@mipmap/ic_launcher</item>
    </style>

</resources>
